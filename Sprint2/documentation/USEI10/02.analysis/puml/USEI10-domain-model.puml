@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

title Domain Model - Track Material Quantities

class ProductionManager {
    name
    email
    password
    role
    phone: String
    trackMaterialQuantities
}

class MaterialTree {
    root: MaterialNode
    addMaterial
    retrieveMaterialsSorted
}

class MaterialNode {
    id
    name
    quantity
    leftChild
    rightChild
}

ProductionManager "1" - "1" MaterialTree : tracks in >
MaterialTree "1" - "*" MaterialNode : contains >

@enduml
