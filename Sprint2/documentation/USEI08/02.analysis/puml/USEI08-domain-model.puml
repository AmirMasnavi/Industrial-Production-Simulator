@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

title System Sequence Diagram (SSD) - Search for Specific Operation or Material

autonumber

actor "Production Manager" as ProductionManager
participant ":System" as System

activate ProductionManager

    ProductionManager -> System : Search for operation/material by ID or name
    activate System

        System -> System : Look up operation/material in map
        System -> System : Retrieve node details (type, quantity, parent operation)

        System --> ProductionManager : Returns node details (type, quantity, parent)

    deactivate System
deactivate ProductionManager

@enduml
