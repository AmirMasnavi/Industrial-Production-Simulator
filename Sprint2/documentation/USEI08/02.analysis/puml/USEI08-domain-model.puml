@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

title Domain Model - Build Production Tree

class ProductionManager {
    name
    email
    password
    role
    phone: String
    buildProductionTree
    manageProducts
    viewProductionDetails
}

class ProductionTree {
    id
    itemName
    operations
    components
    materials
}

class Operation {
    id
    name
    time
    dependencies
}

class Component {
    id
    name
    quantity
}

class Material {
    id
    name
    quantity
}

class CSVImporter {
    importOperations
    importComponents
    importMaterials
}

ProductionManager "1" - "1" CSVImporter : uses >
CSVImporter "1" - "1" ProductionTree : creates >
ProductionTree "1" - "*" Operation : contains >
ProductionTree "1" - "*" Component : contains >
ProductionTree "1" - "*" Material : contains >
Operation "1" - "*" Operation : depends on >
@enduml
